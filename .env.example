# Sin DATABASE_URL la app arranca en modo demo (PGlite) con el café bar de ejemplo.
# Con Supabase: Connect → Transaction pooler (puerto 6543; la directa db.*.supabase.co es solo IPv6 y Vercel no llega).
# Pruébala antes con: DATABASE_URL="…" npm run db:check
# DATABASE_URL=postgresql://postgres.<proyecto>:<clave>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Con base propia: siembra el café bar de ejemplo y deja los pagos simulados.
# DEMO_MODE=true

# Firma la sesión del equipo. 32 caracteres o más al azar. Obligatoria con base propia (sin ella no se abren sesiones).
# SESSION_SECRET=

# Código para dar de alta el local en /alta la primera vez (base vacía, fuera de la demo). 12 caracteres o más.
# SETUP_TOKEN=

# WhatsApp de contacto de la portada, con el 57 y sin espacios.
# NEXT_PUBLIC_SALES_WHATSAPP=573001234567

# Dirección pública (para los QR y enlaces) si no es la de Vercel.
# NEXT_PUBLIC_SITE_URL=https://ronda.example.com

# Postgres: desactiva SSL en local y limita conexiones.
# PGSSL=disable
# PG_POOL_MAX=5

# Postgres con certificado propio: pégalo aquí (con \n en los saltos de línea), o PGSSL=no-verify si no hay cómo.
# Supabase no lo necesita: su certificado raíz ya viene en lib/supabase-ca.ts.
# PGSSL_CA=
# PGSSL=no-verify

# Con base propia y DEMO_MODE=true, permite el botón "Reiniciar demo" (borra todo y vuelve a sembrar).
# ALLOW_DEMO_RESET=true
